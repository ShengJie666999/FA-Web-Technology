# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db
DB_SSL=false

JWT_SECRET=
JWT_EXPIRES_IN=2h
ADMIN_PASSWORD=

# External API 3 (Resend). Leave blank to skip sending emails.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
